from fastapi import 
APIRouter, Depends, Request 
from sqlalchemy.orm import 
Session from 
app.core.templating import 
get_module_templates from 
app.database.session import 
get_db from 
app.modules.equipment.models 
import Equipment from 
app.modules.meter_readings.models 
import MeterReading from 
pathlib import Path router = 
APIRouter(
    prefix="/meter-readings", 
    tags=["Meter Readings"],
) templates = 
get_module_templates(
    str(Path(__file__).parent 
    / "templates")
) def format_number(value): 
    if value is None:
        return "—" try: 
        number = 
        float(value) if 
        number.is_integer():
            return 
            f"{int(number):,}"
        return 
        f"{number:,.1f}"
    except (TypeError, 
    ValueError):
        return str(value) 
def format_date(value):
    if not value: return "—" 
    if isinstance(value, 
    datetime):
        return 
        value.strftime("%d/%m/%Y")
    return str(value) 
@router.get("") 
@router.get("/") async def 
meter_readings_page(
    request: Request, db: 
    Session = 
    Depends(get_db),
): equipment_list = ( 
        db.query(Equipment) 
        .order_by(Equipment.id.asc()) 
        .all()
    ) readings = [] for 
    number, equipment in 
    enumerate(equipment_list, 
    start=1):
        equipment_readings = 
        (
            db.query(MeterReading) 
            .filter(MeterReading.equipment_id 
            == equipment.id) 
            .order_by(
                MeterReading.reading_date.desc(), 
                MeterReading.id.desc(),
            ) .limit(2) 
            .all()
        ) latest = 
        equipment_readings[0] 
        if 
        equipment_readings 
        else None previous = 
        (
            equipment_readings[1] 
            if 
            len(equipment_readings) 
            > 1
            else None ) if 
        latest:
            if 
            latest.odometer 
            is not None:
                reading_value 
                = 
                latest.odometer 
                unit = "كم" 
                if previous 
                and 
                previous.odometer 
                is not None:
                    difference 
                    = 
                    latest.odometer 
                    - 
                    previous.odometer
                else: 
                    difference 
                    = None
            elif 
            latest.hours is 
            not None:
                reading_value 
                = 
                latest.hours 
                unit = "ساعة 
                عمل" if 
                previous and 
                previous.hours 
                is not None:
                    difference 
                    = 
                    latest.hours 
                    - 
                    previous.hours
                else: 
                    difference 
                    = None
            else: 
                reading_value 
                = None unit 
                = "—" 
                difference = 
                None
            if difference is 
            None:
                difference_text 
                = "—" status 
                = "warning"
            else: 
                difference_text 
                = 
                format_number(difference) 
                if 
                float(difference) 
                < 0:
                    status = 
                    "danger"
                else: status 
                    = 
                    "normal"
            note = 
            latest.notes or 
            "—" date = 
            format_date(latest.reading_date)
        else: reading_value 
            = None unit = 
            "—" 
            difference_text 
            = "—" note = "لا 
            توجد قراءة" date 
            = "—" status = 
            "warning"
        readings.append( { 
                "number": 
                number, 
                "type": (
                    equipment.equipment_type.name 
                    if 
                    equipment.equipment_type 
                    else "—"
                ), "model": 
                (
                    equipment.equipment_model.name 
                    if 
                    equipment.equipment_model 
                    else "—"
                ), 
                "registration": 
                equipment.registration_number 
                or "—", 
                "location": 
                "—", "unit": 
                unit, 
                "date": 
                date, 
                "reading": 
                format_number(reading_value), 
                "difference": 
                difference_text, 
                "note": 
                note, 
                "status": 
                status,
            }
        ) last_update = "—" 
    all_latest = (
        db.query(MeterReading) 
        .order_by(
            MeterReading.reading_date.desc(), 
            MeterReading.id.desc(),
        ) .first() ) if 
    all_latest:
        last_update = 
        format_date(all_latest.reading_date)
    return 
    templates.TemplateResponse(
        "meter_readings.html", 
        {
            "request": 
            request, 
            "readings": 
            readings, 
            "last_update": 
            last_update,
        },
    )from datetime import 
    datetime
